                                            : '' %>>
                                        <label for="toggle-2" class="toggle-slider-label"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="command">
                                <h2>Command 3</h2>
                                <div class="top-inputs">
                                    <input type="text" max="255" name="title3" placeholder="Title"
                                        value="<%= locals.customMinecraftModules[2] != undefined ? locals.customMinecraftModules[2].eventName : '' %>">
                                    <input type="text" max="255" name="description3" placeholder="Description"
