                                            value="<%= locals.customMinecraftModules[3] != undefined ? locals.customMinecraftModules[3].inputPlaceholder : ''  %>">
                                    </div>
                                    <h3>Enable Command</h3>
                                    <div class="toggle-slider">
                                        <input type="checkbox" name="toggled4" id="toggle-4"
                                            class="toggle-slider-checkbox toggle" <%=locals.customMinecraftModules[3]
                                            !=undefined && locals.customMinecraftModules[3].isEnabled==1 ? 'checked'
                                            : '' %>>
                                        <label for="toggle-4" class="toggle-slider-label"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="command">
                                <h2>Command 5</h2>
                                <div class="top-inputs">
                                    <input type="text" max="255" name="title5" placeholder="Title"
                                        value="<%= locals.customMinecraftModules[4] != undefined ? locals.customMinecraftModules[4].eventName : '' %>">
                                    <input type="text" max="255" name="description5" placeholder="Description"
                                        value="<%= locals.customMinecraftModules[4] != undefined ? locals.customMinecraftModules[4].eventDescription : '' %>">
                                </div>
                                <textarea placeholder="Command" rows=3 name="command5"
