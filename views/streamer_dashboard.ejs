                                    </div>
                                    <h3>Enable Command</h3>
                                    <div class="toggle-slider">
                                        <input type="checkbox" name="toggled5" id="toggle-5"
                                            class="toggle-slider-checkbox toggle" <%=locals.customMinecraftModules[4]
                                            !=undefined && locals.customMinecraftModules[4].isEnabled==1 ? 'checked'
                                            : '' %>>
                                        <label for="toggle-5" class="toggle-slider-label"></label>
