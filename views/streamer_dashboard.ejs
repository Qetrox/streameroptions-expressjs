                                </div>
                                <textarea placeholder="Command" rows=3 name="command3"
                                    maxlength="255"><%= locals.customMinecraftModules[2] != undefined ? locals.customMinecraftModules[2].eventCommandString  : '' %></textarea>
                                <input min="0" type="number" name="price3" placeholder="Price"
                                    value="<%= locals.customMinecraftModules[2] != undefined ? locals.customMinecraftModules[2].eventCost : '' %>">
                                <div class="sliders">
                                    <h3>Viewer Input</h3>
                                    <div class="viewer-input">
                                        <div class="toggle-slider">
                                            <input type="checkbox" name="inputtoggled3" id="inputtoggle3"
                                                class="toggle-slider-checkbox toggle"
                                                <%=(locals.customMinecraftModules[2] !=undefined &&
                                                locals.customMinecraftModules[2].inputEnabled==1) ? 'checked' : '' %>>
                                            <label for="inputtoggle3" class="toggle-slider-label"></label>
                                        </div>
                                        <input type="text" max="255" name="viewerinputplaceholder3"
                                            placeholder="Placeholder"
                                            value="<%= locals.customMinecraftModules[2] != undefined ? locals.customMinecraftModules[2].inputPlaceholder : ''  %>">
                                    </div>
                                    <h3>Enable Command</h3>
                                    <div class="toggle-slider">
                                        <input type="checkbox" name="toggled3" id="toggle-3"
                                            class="toggle-slider-checkbox toggle" <%=locals.customMinecraftModules[2]
                                            !=undefined && locals.customMinecraftModules[2].isEnabled==1 ? 'checked'
                                            : '' %>>
                                        <label for="toggle-3" class="toggle-slider-label"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="command">
                                <h2>Command 4</h2>
                                <div class="top-inputs">
                                    <input type="text" max="255" name="title4" placeholder="Title"
                                        value="<%= locals.customMinecraftModules[3] != undefined ? locals.customMinecraftModules[3].eventName : '' %>">
                                    <input type="text" max="255" name="description4" placeholder="Description"
