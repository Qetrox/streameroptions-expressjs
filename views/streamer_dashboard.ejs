<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="apple-touch-icon" sizes="180x180" href="<%= locals.hostname || '' %>/fav/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= locals.hostname || '' %>/fav/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= locals.hostname || '' %>/fav/favfavicon-16x16.png">
    <link rel="manifest" href="<%= locals.hostname || '' %>/fav/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.WebsiteTitleElementText %>
    </title>
    <link rel="stylesheet" type="text/css" href="<%= locals.CssUrl || 'stylesheet1.css' %>">
    <link rel="stylesheet" type="text/css"
        href="<%= locals.hostname + '/base_stylesheet.css' || 'localhost/base_stylesheet1.css' %>">
    <%- include('parts/metatags.ejs') %>
    <meta name="robots" content="noindex">
</head>

<% let customMinecraftModulesEnabled=0; for(let key in locals.customMinecraftModules) {
    if(locals.customMinecraftModules[key].isEnabled==1) { customMinecraftModulesEnabled++; } } %>

    <body>
        <%- include('parts/header.ejs') %>
            <main>
                <div id="MinecraftCustomCommandEditor" class="MinecraftCustomCommandEditor">
                    <div class="modal" id="mcModal">
                        <h1>Edit your custom commands</h1>
                        <form action="./save-custom-minecraft-modules" method="GET" id="mcModalForm">
                            <div class="command">
                                <h2>Command 1</h2>
                                <div class="top-inputs">
                                    <input type="text" max="255" name="title1" placeholder="Title"
                                        value="<%= locals.customMinecraftModules[0] != undefined ? locals.customMinecraftModules[0].eventName : '' %>">
                                    <input type="text" max="255" name="description1" placeholder="Description"
                                        value="<%= locals.customMinecraftModules[0] != undefined ? locals.customMinecraftModules[0].eventDescription : '' %>">
                                </div>
                                <textarea placeholder="Command" rows=3 name="command1"
                                    maxlength="255"><%= locals.customMinecraftModules[0] != undefined ? locals.customMinecraftModules[0].eventCommandString  : '' %></textarea>
                                <input min="0" type="number" name="price1" placeholder="Price"
                                    value="<%= locals.customMinecraftModules[0] != undefined ? locals.customMinecraftModules[0].eventCost : '' %>">
                                <div class="sliders">
                                    <h3>Viewer Input</h3>
                                    <div class="viewer-input">
                                        <div class="toggle-slider">
                                            <input type="checkbox" name="inputtoggled1" id="inputtoggle1"
                                                class="toggle-slider-checkbox toggle"
                                                <%=(locals.customMinecraftModules[0] !=undefined &&
                                                locals.customMinecraftModules[0].inputEnabled==1) ? 'checked' : '' %>>
                                            <label for="inputtoggle1" class="toggle-slider-label"></label>
                                        </div>
                                        <input type="text" max="255" name="viewerinputplaceholder1"
                                            placeholder="Placeholder"
                                            value="<%= locals.customMinecraftModules[0] != undefined ? locals.customMinecraftModules[0].inputPlaceholder : ''  %>">
                                    </div>
                                    <h3>Enable Command</h3>
                                    <div class="toggle-slider">
                                        <input type="checkbox" name="toggled1" id="toggle-1"
                                            class="toggle-slider-checkbox toggle" <%=locals.customMinecraftModules[0]
                                            !=undefined && locals.customMinecraftModules[0].isEnabled==1 ? 'checked'
                                            : '' %>>
                                        <label for="toggle-1" class="toggle-slider-label"></label>
                                    </div>
                                </div>
                            </div>
                            <div class="command">
                                <h2>Command 2</h2>
