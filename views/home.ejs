<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="apple-touch-icon" sizes="180x180" href="<%= locals.hostname || '' %>/fav/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= locals.hostname || '' %>/fav/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= locals.hostname || '' %>/fav/favfavicon-16x16.png">
    <link rel="manifest" href="<%= locals.hostname || '' %>/fav/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.WebsiteTitleElementText %>
    </title>
    <link rel="stylesheet" type="text/css" href="<%= locals.CssUrl || 'stylesheet1.css' %>">
    <link rel="stylesheet" type="text/css"
        href="<%= locals.hostname + '/base_stylesheet.css' || 'localhost/base_stylesheet1.css' %>">

    <%- include('parts/metatags.ejs') %>

</head>

<body>
    <%- include('parts/header.ejs') %>
        <main>
            <div class="banner" id="banner" style="background-color: #050505;">
                <h1>Create more <span class="coolcolor">interaction</span> with viewers</h1>
                <h3>Keep your viewers engaged by allowing them to <span class="coolcolor">influence your games</span>
                    using simple and effective tools.</h3>
                <a href="#features" class="feature-scrolldown fade-in">
                    <h1 class="slide-in feature-right">Features</h1>
                    <span class="slide-in feature-right material-symbols-outlined">arrow_circle_down</span>
                </a>
            </div>
            <div class="featured-streamers">
                <div class="vp">
                    <div class="streamer-list">
                        <% const streamer_display=locals.featured_streamer_list || [];
                            streamer_display.forEach((streamer, index)=> {

                            const previousStreamer = index > 0 ? streamer_display[index - 1] :
                            streamer_display[streamer_display.length - 1];
                            const nextStreamer = index < streamer_display.length - 1 ? streamer_display[index + 1] :
                                streamer_display[0]; %>
                                <div class="streamer-container">
                                    <div class="streamer"
                                        style="background-image: url('<%= nextStreamer.userProfileImageUrl %>');"
                                        onclick="javascript:window.location.href='./<%= nextStreamer.userUsername %>'">
                                    </div>
                                    <div class="streamer"
                                        style="background-image: url('<%= streamer.userProfileImageUrl %>');"
                                        onclick="javascript:window.location.href='./<%= streamer.userUsername %>'">
                                    </div>
                                    <div class="streamer"
                                        style="background-image: url('<%= previousStreamer.userProfileImageUrl %>');"
                                        onclick="javascript:window.location.href='./<%= previousStreamer.userUsername %>'">
                                    </div>
                                </div>
                                <% }) %>
                    </div>
                </div>
            </div>
            <div class="features" id="features">
                <h1>Features</h1>
                <div class="feature fade-in">
                    <div class="slide-in feature-left">
                        <h1>Creating interaction with viewers</h1>
                        <p>Using Streamer Options any creator, small or large, can make their viewers interact with the
                            stream with just a few clicks.
                        </p>
                    </div>
                    <img class="slide-in feature-right no-shadow" src="./i/TwitchLogo.png" alt="">
                </div>
                <div class="feature fade-in">
                    <img class="slide-in feature-left" src="./i/banner0.png" alt="">
                    <div class="slide-in feature-right">
                        <h1>Collecting points</h1>
                        <p>Viewers gain points when watching your stream. With these points they are able to interact
                            with your games.</p>
                    </div>
                </div>
                <div class="feature fade-in">
                    <div class="slide-in feature-left">
                        <h1>Easy to use</h1>
                        <p>Skip creating an account and log in with your Twitch. This way we are able to configure
                            almost everything automatically.<br><br>You only need to download and install your desired
                            mods or plugins and with the help of our thorough guides you are able to configure these
                            within minutes!</p>
                    </div>
                    <img class="slide-in feature-right" src="./i/modules.png" alt="">
                </div>
                <div class="feature fade-in">
                    <img class="slide-in feature-left" src="./i/guides.png" alt="">
                    <div class="slide-in feature-right">
                        <h1>Fit to your needs</h1>
                        <p>You have full control over what your viewers can do with their points. Enable or disable
                            modules and change the prices for viewers.</p>
                    </div>
                </div>

                <div class="feature-buttons">
                    <a href="./streamer/dashboard" class="button">
                        <h1>Get started
                            <span class="material-symbols-outlined">
                                arrow_outward
                            </span>
                        </h1>
                    </a>
                    <a href="./guides" class="button">
                        <h1>Read our guides
                            <span class="material-symbols-outlined">
                                arrow_outward
                            </span>
                        </h1>
                    </a>
                </div>

            </div>
            <div class="supported-games" id="supported-games">
                <h1>Supported games</h1>

                <div class="game" style="background-image: url(./i/banner0.png);">
                    <h1 class="gametitle">Minecraft</h1>
                    <a href="">
                        <p class="downloadoption">Spigot Plugin<span class="material-symbols-outlined">
                                arrow_outward
                            </span></p>
                    </a>
                    <a href="">
                        <p class="downloadoption">???<span class="material-symbols-outlined">
                                arrow_outward
                            </span></p>
                    </a>
                </div>
                <div class="game">
                    <h1 class="gametitle">Upcoming Game</h1>
                    <a href="">
                        <p class="downloadoption">???<span class="material-symbols-outlined">
                                arrow_outward
                            </span></p>
                    </a>
                </div>

            </div>
        </main>
        <script src="./js1.js"></script>
        <%- include('parts/footer.ejs') %>
</body>

</html>