<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="apple-touch-icon" sizes="180x180" href="<%= locals.hostname || '' %>/fav/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= locals.hostname || '' %>/fav/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= locals.hostname || '' %>/fav/favfavicon-16x16.png">
    <link rel="manifest" href="<%= locals.hostname || '' %>/fav/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.WebsiteTitleElementText %></title>
    <link rel="stylesheet" type="text/css" href="<%= locals.CssUrl || 'stylesheet1.css' %>">
    <link rel="stylesheet" type="text/css" href="<%= locals.hostname + '/base_stylesheet.css' || 'localhost/base_stylesheet1.css' %>">

    <%- include('parts/metatags.ejs') %>

</head>
<body>
    <%- include('parts/header.ejs') %>
    <main>
        <div class="banner" id="banner" style="background-color: #050505;">
            <h1>Streamer Options</h1>
            <h3>Your way to create interaction with viewers</h3>
            <a href="#features" class="feature-scrolldown fade-in">
                <h1 class="slide-in feature-right">Features</h1>
                <span class="slide-in feature-right material-symbols-outlined">arrow_circle_down</span>
            </a>
        </div>
        <div class="featured-streamers">
            <h1>Featured Streamers</h1>
            <div class="vp">
                <div class="streamer-list">
                    <% 
                    const streamer_display = locals.featured_streamer_list || [];
                    streamer_display.forEach((streamer, index) => {

                        const previousStreamer = index > 0 ? streamer_display[index - 1] : streamer_display[streamer_display.length - 1];
                        const nextStreamer = index < streamer_display.length - 1 ? streamer_display[index + 1] : streamer_display[0];

                    %>
                    <div class="streamer-container">
                        <div class="streamer" style="background-image: url('<%= nextStreamer.userProfileImageUrl %>');" onclick="javascript:window.location.href='./<%= nextStreamer.userUsername %>'"></div>
                        <div class="streamer" style="background-image: url('<%= streamer.userProfileImageUrl %>');" onclick="javascript:window.location.href='./<%= streamer.userUsername %>'"></div>
                        <div class="streamer" style="background-image: url('<%= previousStreamer.userProfileImageUrl %>');" onclick="javascript:window.location.href='./<%= previousStreamer.userUsername %>'"></div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
        <div class="features" id="features">
            <h1>Features</h1>
            <div class="feature fade-in">
                <div class="slide-in feature-left">
                    <h1>No Account required, Just use Twitch</h1>
                    <p>To utilize our array of services, we ask you to sign in using Twitch. You may be sure that as soon as you log in, everything goes smoothly and does not require you to do anything else.</p>
                </div>
                <img class="slide-in feature-right no-shadow" src="./i/TwitchLogo.png" alt="">
            </div>
            <div class="feature fade-in">
                <img class="slide-in feature-left" src="./i/banner0.png" alt="">
                <div class="slide-in feature-right">
                    <h1>Keep your viewers engaged</h1>
                    <p>By participating in your stream, viewers can gain points that can be used to activate different in-game features, which enhances the excitement and interaction of the viewing experience.</p>
                </div>
            </div>
            <div class="feature fade-in">
                <div class="slide-in feature-left">
                    <h1>Fit to your needs</h1>
                    <p>With the ability to quickly turn on and off modules and change the price points, you can easily manage your stream and give your audience a customized viewing experience.</p>
                </div>
                <img class="slide-in feature-right" src="./i/modules.png" alt="">
            </div>
            <div class="feature fade-in">
                <img class="slide-in feature-left"src="./i/guides.png" alt="">
                <div class="slide-in feature-right">
                    <h1>Easy setup</h1>
                    <p>With the help of our thorough guides, you can quickly set up our services and get up and running in a matter of minutes. The implementation process takes up very little of your time.</p>
                </div>
            </div>
            <div class="feature fade-in">
                <div class="slide-in feature-left">
                    <h1>It is FREE!</h1>
                    <p>Take advantage of Streamer Options, which is completely free with no paywall restrictions, allowing you to explore and leverage its features without financial constraints.</p>
                </div>
                <img class="slide-in feature-right no-shadow" src="./i/nomoneyz.png" alt="">
            </div>
        </div>
    </main>
    <script src="./js1.js"></script>
    <%- include('parts/footer.ejs') %>
</body>
</html>