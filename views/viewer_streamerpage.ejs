<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="apple-touch-icon" sizes="180x180" href="<%= locals.hostname || '' %>/fav/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= locals.hostname || '' %>/fav/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= locals.hostname || '' %>/fav/favfavicon-16x16.png">
    <link rel="manifest" href="<%= locals.hostname || '' %>/fav/site.webmanifest">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.WebsiteTitleElementText %></title>
    <link rel="stylesheet" type="text/css" href="<%= locals.CssUrl || 'stylesheet1.css' %>">
    <link rel="stylesheet" type="text/css" href="<%= locals.hostname + '/base_stylesheet.css' || 'localhost/base_stylesheet1.css' %>">

    <meta name="description" content="<%= locals.streamerdescription || '' %>">
    <meta name="robots" content="noindex">
    <meta name="keywords" content="Streamer Options, Streameroptions, Twitch stream interaction, viewer interaction, streamer interaction, streamer options, streameroptions.com, streamer, minecraft live interaction, twitch live, twitch interaction, twitch viewer interaction">
    <meta name="author" content="Streamer Options - <%= locals.streamername || '' %>">
    <meta name="url" content="https://www.streameroptions.com/">
    <meta property="og:title" content="Streamer Options - <%= locals.streamername || '' %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.streameroptions.com" />
    <meta property="og:image" content="<%= locals.streamerProfileImageUrl%>" />
    <meta property="og:description" content="<%= locals.streamerdescription || '' %>" />

</head>
<body>
    <%- include('parts/header.ejs') %>

    <main>
        <div class="streamer-info">
            <div class="profile">
                <div class="image">
                    <img src="<%= locals.streamerProfileImageUrl%>" alt="">
                </div>
                <div class="heading">
                    <h1><%= locals.streamername || '' %></h1>
                    <h4><%= locals.streamerslogan || '' %></h4>
                </div>
            </div>
            <h4>Active Since <%= locals.activesince || '--/--/--' %></h4>
            <div class="description">
                <p><%= locals.streamerdescription || '' %></p>
            </div>
        </div>
        <div class="redeemables">

            <div class="viewer-info">
                Points: <%= locals.points %>
            </div>
            <% for(let key in locals.modules.minecraft) { 
                let module = locals.modules.minecraft[key]; %>
                <div class="redeemable<%= module.price > locals.points ? ' not-enough' : ''%>">
                    <form action="" method="POST">
                        <h1><%= module.title %> - <%= module.price %> Points</h1>
                        <div class="redeemable-description">
                            <div class="redeemable-image">
                                <img src="<%= module.image_url %>" alt="image">
                            </div>
                            <p><%= module.description %></p>
                        </div>
                        <input type="hidden" name="type" value="minecraft">
                        <input type="hidden" name="redeemed_by" value="<%= locals.viewername %>">
                        <input type="hidden" name="event_type" value="<%= module.data_name %>">
                        <% if(module.data_name == "whitelist_add") { %>
                        <input type="text" name="minecraft_username" placeholder="Minecraft Username">
                        <% } %>
                        <% if(module.data_name == "change_weather") { %>

                        <select name="weather_type">
                            <option value="clear">Clear</option>
                            <option value="rain">Rain</option>
                            <option value="storm">Thunder</option>
                        </select>
                        <% } %>
                        <input type="submit" value="<%= module.price > locals.points ? 'Not enough points' : 'Activate'%>" class="save-button <%= module.price > locals.points ? ' disabled' : ''%>"<%= module.price > locals.points ? ' disabled' : ''%>>
                    </form>
                </div>
            <% } %>
            <% for(let key in locals.customMCModules) { 
                let customModule = locals.customMCModules[key]; %>
                <div class="redeemable<%= customModule.eventCost > locals.points ? ' not-enough' : ''%>">
                    <form action="" method="POST">
                        <h1><%= customModule.eventName %> - <%= customModule.eventCost %> Points</h1>
                        <div class="redeemable-description">
                            <p><%= customModule.eventDescription %></p>
                        </div>
                        <input type="hidden" name="type" value="minecraft">
                        <input type="hidden" name="redeemed_by" value="<%= locals.viewername %>">
                        <input type="hidden" name="event_type" value="<%= customModule.streamerEventId %>">
                        <% if(customModule.inputEnabled == 1) { %>
                        <input type="text" name="minecraft_username" placeholder="<%= customModule.inputPlaceholder %>">
                        <% } %>
                        <input type="submit" value="<%= customModule.eventCost > locals.points ? 'Not enough points' : 'Activate'%>" class="save-button <%= customModule.eventCost > locals.points ? ' disabled' : ''%>"<%= customModule.eventCost > locals.points ? ' disabled' : ''%>>
                    </form>
                </div>
            <% } %>
        </div>

    </main>
    <%- include('parts/footer.ejs') %>
</body>
</html>