<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.WebsiteTitleElementText %></title>
    <link rel="stylesheet" type="text/css" href="<%= locals.CssUrl || 'stylesheet1.css' %>">
    <link rel="stylesheet" type="text/css" href="<%= locals.hostname + '/base_stylesheet.css' || 'localhost/base_stylesheet1.css' %>">
</head>
<body>
    <%- include('parts/header.ejs') %>
    <main>
        <% 
        streamer_points = locals.streamer_points || [];
        
        streamer_points.forEach((pointspage) => {
            %>
            
            <div class="streamer_points" onclick="javascript:window.location.href='./<%= pointspage.userDisplayname %>'">
                <h2><%= pointspage.userDisplayname %></h2>
                <p><%= pointspage.points %> points</p>
            </div>
            <%
        }) %>
    </main>
    <%- include('parts/footer.ejs') %>
</body>
</html>